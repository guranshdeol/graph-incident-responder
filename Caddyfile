{$PUBLIC_HOST} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
	# live estate (compose profile "aws"): operator token required
	redir /live /live/
	handle_path /live/* {
		reverse_proxy api-live:8000
	}
	# public sandbox
	handle {
		reverse_proxy api:8000
	}
}
