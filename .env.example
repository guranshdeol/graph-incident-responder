# Copy to .env and fill in. Never commit .env.
PUBLIC_HOST=<linode-ip-with-dashes>.sslip.io
FALKORDB_PASSWORD=          # openssl rand -hex 24
WEBHOOK_TOKEN=              # openssl rand -hex 32; same value in alertmanager.yml
LLM_API_KEY=
GRAPH_LIVE=ops_live
GRAPH_SANDBOX=ops_sandbox
SANDBOX_MODE=true
ADMIN_TOKEN=               # openssl rand -hex 32; operator token when SANDBOX_MODE=false
PROMETHEUS_URL=            # e.g. http://<host-1>:9090; empty = probes report unknown

# --- live AWS (tomorrow): produced by `python -m demo.aws.estate up` in demo/aws/credentials.env
AWS_REGION=ap-south-1
CHANGES_QUEUE_URL=
DISCOVERY_AWS_ACCESS_KEY_ID=
DISCOVERY_AWS_SECRET_ACCESS_KEY=
INGESTER_AWS_ACCESS_KEY_ID=
INGESTER_AWS_SECRET_ACCESS_KEY=
EXECUTOR_AWS_ACCESS_KEY_ID=
EXECUTOR_AWS_SECRET_ACCESS_KEY=
ORDERS_DB_PASSWORD=
